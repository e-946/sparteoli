<?xml version="1.0"?>
<ruleset name="Sparteoli"
    xmlns="http://pmd.sf.net/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">

    <description>PHPMD ruleset for the Sparteoli project.</description>

    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
    <rule ref="rulesets/design.xml">
        <!-- A base Controller naturally has one child per resource controller. -->
        <exclude name="NumberOfChildren"/>
    </rule>

    <rule ref="rulesets/naming.xml">
        <!-- Laravel migrations require methods named exactly up()/down(). -->
        <exclude name="ShortMethodName"/>
        <!-- Laravel route-model-binding parameters are conventionally $id; overridden below. -->
        <exclude name="ShortVariable"/>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id"/>
        </properties>
    </rule>
</ruleset>
