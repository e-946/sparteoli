<?xml version="1.0"?>
<ruleset name="Sparteoli">
    <description>PHPCS ruleset for the Sparteoli project.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <!-- Laravel migrations use anonymous classes ("return new class extends
         Migration"), which are intentionally not namespaced. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>database/migrations/*</exclude-pattern>
    </rule>

    <!-- Test methods use PHPUnit/Laravel's snake_case "test_*" naming
         convention (the same convention php artisan make:test scaffolds),
         not PSR-1's camelCase method names. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
